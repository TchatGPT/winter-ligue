# =============================================================================
# Winter Ligue — variables d'environnement
# Copier ce fichier en `.env.local` et renseigner les valeurs.
# `.env.local` est ignoré par git : aucun secret ne doit être commité.
# =============================================================================

# -----------------------------------------------------------------------------
# OBLIGATOIRE EN PRODUCTION
# -----------------------------------------------------------------------------

# Clé de signature des sessions et de l'état OAuth. 32 caractères minimum.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# En production, l'application refuse de démarrer sans elle.
AUTH_SECRET=

# URL publique du site, sans barre oblique finale.
# Sert à la vérification d'origine (protection CSRF) et à la redirection OAuth.
NEXT_PUBLIC_SITE_URL=https://winter-ligue.com

# -----------------------------------------------------------------------------
# AUTHENTIFICATION TWITCH — la seule porte d'entrée du site
# Tant que ces deux variables sont vides, personne ne peut se connecter : le
# site se visite, mais ne se joue pas.
# Créer l'application sur https://dev.twitch.tv/console/apps
# URL de redirection à déclarer : <NEXT_PUBLIC_SITE_URL>/api/auth/twitch/callback
# -----------------------------------------------------------------------------

# La chaîne de la ligue, en minuscules (par défaut : lriaa). La streameuse et
# ses modérateurs Twitch administrent le site ; les autres y jouent.
TWITCH_BROADCASTER_LOGIN=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# LECTURE DES CAPTURES DE FIN DE GAME (saisie assistée par IA)
# Sans clé, l'écran de saisie propose seulement la saisie à la main.
# Créer la clé sur https://console.anthropic.com/ — elle ne quitte jamais le
# serveur. ANTHROPIC_MODEL est facultatif (par défaut : claude-opus-5).
# -----------------------------------------------------------------------------

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# -----------------------------------------------------------------------------
# BASE DE DONNÉES (Supabase)
# La chaîne de connexion du pooler partagé de Supabase : Connect, Direct,
# « IPv4 connection » activé, Type URI. Port 6543 (mode transaction) ; une
# adresse en 5432 est ramenée sur 6543 par le code, le mode session plafonnant
# à 15 connexions, trop peu pour Vercel.
# Pour y verser les données locales une fois : npm run importe-base
# -----------------------------------------------------------------------------

DATABASE_URL=

# -----------------------------------------------------------------------------
# FACULTATIF
# -----------------------------------------------------------------------------

# Emplacement du fichier de données. Par défaut : .data/league.json
# À remplacer par une vraie base de données avant la mise en production
# multi-instances (voir docs/SECURITE.md).
# LEAGUE_DATA_FILE=

# Secret partagé pour la clôture automatique des ventes échues.
# Appelé par un cron : POST /api/market/close, en-tête Authorization: Bearer …
# Sans lui, la route est fermée et la clôture reste paresseuse (à la visite).
CRON_SECRET=

# Connexion joueur de développement, pour tester cartes et enchères sans Twitch.
# Ignorée dès que NODE_ENV=production, quelle que soit sa valeur.
ALLOW_DEV_LOGIN=true
